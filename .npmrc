# Reject installs on Node versions Vite 8 can't run on (^20.19 || >=22.12).
# Without this, npm happily installs on Node 18 and Vite crashes at startup
# with "CustomEvent is not defined" — which surfaces in the browser as an
# opaque 500. engine-strict turns that into a clear, upfront npm error instead.
engine-strict=true